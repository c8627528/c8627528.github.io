  ];
  const frames = document.getElementById('rs-frames');
  const scene = document.getElementById('rs-scene');
  let cur = 0;

  // 齿孔
  const perf = document.getElementById('reel-perf');
  let holes = '';
  for(let i=0;i<42;i++){ holes += '<div class="hole"></div>'; }
