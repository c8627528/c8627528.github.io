  }
  function go(i){
    i = (i + DATA.length) % DATA.length;
    if(i===cur) return;
    scene.classList.add('fading');
    cur = i;
    setTimeout(()=>{ render(cur); scene.classList.remove('fading'); }, 220);
  }
  document.getElementById('rs-prev').addEventListener('click', ()=>go(cur-1));
  document.getElementById('rs-next').addEventListener('click', ()=>go(cur+1));
