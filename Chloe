/* 滚动渐入 */
function startVlogIO(){
  const DATA = [
    {vol:'01', no:'01', cn:'壹', title:'曼彻斯特大教堂', video:'https://aka.doubaocdn.com/s/TgU2hwNY0t', poster:'https://aka.doubaocdn.com/s/xpNPCWstUV', desc:'《伦敦生活》的片尾曲，曼彻斯特的大教堂。', date:'2026.10.22', cond:'午后', loc:'爱丁堡 · 教堂', tags:['彩窗','祈祷','字幕'], dur:'00:03'},
    {vol:'02', no:'02', cn:'贰', title:'手记', video:'https://aka.doubaocdn.com/s/LxSa7YyJwj', poster:'https://aka.doubaocdn.com/s/RxuIlFHnYy', desc:"Is someone in the crowd the only thing you really see. Watching while the world keeps spinning' round.", date:'2026.10.22', cond:'晴', loc:'途中 · 手记', tags:['手写','暗语','THE ONLY'], dur:'00:08'},
    {vol:'03', no:'03', cn:'叁', title:'英伦回忆录', video:'https://aka.doubaocdn.com/s/jutauWpG9P', poster:'https://aka.doubaocdn.com/s/LsR2Qd8rqk', desc:'Portobello, The Lake District, Scottish Highlands, London, Manchester, Edinburgh...', date:'2026.10.22', cond:'黄昏', loc:'爱丁堡 · 水岸', tags:['浅滩','双影','水'], dur:'00:14'},
    {vol:'04', no:'04', cn:'肆', title:'花野', video:'https://aka.doubaocdn.com/s/XZ7cJzNmeb', poster:'https://aka.doubaocdn.com/s/cIHeYop7jJ', desc:'一起去滨江公园看粉黛子草吧。', date:'2026.10.22', cond:'晴', loc:'郊野 · 花径', tags:['背影','花野','风'], dur:'00:15'},
