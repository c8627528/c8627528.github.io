/* ReflectiveCard 效果（原生移植：倾斜 + 跟随光晕 + 描边 + 扫光） */
(function(){
  const clamp = (v,a,b)=>Math.min(b,Math.max(a,v));
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.spotlight-card').forEach(root=>{
    const gloss = document.createElement('span'); gloss.className='rc-gloss';
    const rim = document.createElement('span'); rim.className='rc-rim';
    root.appendChild(gloss); root.appendChild(rim);
    let rx=0, ry=0, gx=50, gy=40, go=0;
    let tx=0, ty=0, tgx=50, tgy=40, tgo=0;
    let raf=0, last=0;
    const apply = ()=>{
      root.style.setProperty('--rx', rx.toFixed(2)+'deg');
      root.style.setProperty('--ry', ry.toFixed(2)+'deg');
      root.style.setProperty('--gx', gx.toFixed(2)+'%');
      root.style.setProperty('--gy', gy.toFixed(2)+'%');
      root.style.setProperty('--go', go.toFixed(3));
    };
    const frame = now=>{
      raf=0;
      const dt = Math.min(0.05,(now-last)/1000||0); last=now;
      const k = 1-Math.exp(-dt*9);
      rx += (tx*12-rx)*k; ry += (-ty*12-ry)*k;
      gx += (tgx-gx)*k; gy += (tgy-gy)*k; go += (tgo-go)*k;
      apply();
      if(Math.abs(rx-tx*12)>0.05||Math.abs(ry+ty*12)>0.05||Math.abs(gx-tgx)>0.2||Math.abs(gy-tgy)>0.2||Math.abs(go-tgo)>0.02) raf=requestAnimationFrame(frame);
    };
    const wake = ()=>{ if(!raf){ last=performance.now(); raf=requestAnimationFrame(frame); } };
    const aimAt = e=>{
      const r = root.getBoundingClientRect();
      if(!r.width||!r.height) return;
      const nx = ((e.clientX-r.left)/r.width)*2-1;
      const ny = ((e.clientY-r.top)/r.height)*2-1;
      const tilt = root.classList.contains('focused') ? 0.5 : 1;
      tx = clamp(nx,-1,1)*tilt; ty = clamp(ny,-1,1)*tilt;
      tgx = (tx+1)*50; tgy = (ty+1)*50; tgo = reduce?0.4:1;
      wake();
    };
    const release = ()=>{ tx=0; ty=0; tgo=0; wake(); };
    root.addEventListener('pointerenter', aimAt);
    root.addEventListener('pointermove', aimAt);
    root.addEventListener('pointerleave', release);
    apply();
  });
})();

/* 卡片聚焦：点击放大居中（lightbox），点空白恢复 */
(function(){
  const view = document.getElementById('view-practice');
  if(!view) return;
  const cards = Array.from(view.querySelectorAll('.spotlight-card'));
  const stage = document.getElementById('stage');
  const stageScale = () => stage ? (stage.getBoundingClientRect().width / 1920) : 1;
  /* 放大倍率：比原本大 —— 固定 1.5 倍 */
  const ZOOM = 1.5;
  const applyFocus = card => {
    const r = card.getBoundingClientRect();
    const s = stageScale();
    card.style.setProperty('--dx', ((window.innerWidth/2 - (r.left+r.width/2)) / s) + 'px');
    card.style.setProperty('--dy', ((window.innerHeight/2 - (r.top+r.height/2)) / s) + 'px');
    card.style.setProperty('--sc', String(ZOOM));
  };
  const reset = () => {
    cards.forEach(c=>{
      c.classList.remove('focused');
      c.style.removeProperty('--dx'); c.style.removeProperty('--dy'); c.style.removeProperty('--sc');
    });
    view.classList.remove('focused');
  };
  cards.forEach(card=>card.addEventListener('click', e=>{
    e.stopPropagation();
    reset();
    view.classList.add('focused');
    card.classList.add('focused');
    applyFocus(card);
  }));
  /* 点击背景空白处（view 内非卡片区域）恢复原排布 */
  view.addEventListener('click', reset);
  window.addEventListener('resize', ()=>{
    const f = view.querySelector('.spotlight-card.focused');
    if(f) applyFocus(f);
  });
})();

