    if(e.key==='ArrowLeft'){ e.preventDefault(); go(cur-1); }
  });

  const video = document.getElementById('rs-video');
  const playBtn = document.getElementById('rs-play-btn');
  function togglePlay(){
    if(!video.src) return;
    if(video.paused){ video.play(); } else { video.pause(); }
