  frames.addEventListener('mouseenter', ()=> frames.classList.add('hovering'));
  frames.addEventListener('mouseleave', ()=> frames.classList.remove('hovering'));

  function render(i){
    const d = DATA[i];
    scene.style.background = d.grad;
    video.pause();
    video.src = d.video;
    video.poster = d.poster;
    video.load();
    document.getElementById('rs-reel').textContent = 'REEL ' + d.vol;
