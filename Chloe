let bookPage = 0;
const bpagesEl = document.getElementById('bpages');

function buildBook(){
  bpagesEl.innerHTML = '';
  BOOK_PAGES.forEach((pg, i)=>{
    const el = document.createElement('div');
    el.className = 'bpage';
    el.dataset.idx = i;
    el.innerHTML = `
      <div class="bpage-face">${pg.front}</div>
      <div class="bpage-face back">${pg.back}</div>`;
    bpagesEl.appendChild(el);
  });
  updateBook();
}
function updateBook(){
  const pages = bpagesEl.querySelectorAll('.bpage');
  pages.forEach((p, i)=>{
    const flipped = i < bookPage;
    p.classList.toggle('flipped', flipped);
    // 正在翻的页z最高，避免右边页先露出来
    let z;
    if(i === bookPage || i === bookPage - 1){
      z = 999;
    }else if(flipped){
      z = 100 + i;
    }else{
      z = 200 - i;
    }
    p.style.zIndex = z;
  });
  // 动画结束后恢复正常z-index
  clearTimeout(updateBook._t);
  updateBook._t = setTimeout(()=>{
    pages.forEach((p, i)=>{
      const flipped = i < bookPage;
      if(i === bookPage || i === bookPage - 1) return;
      p.style.zIndex = flipped ? 100 + i : 200 - i;
    });
  }, 1300);
  document.getElementById('book-prev').style.visibility = bookPage<=0 ? 'hidden':'visible';
  document.getElementById('book-next').style.visibility = bookPage>=BOOK_PAGES.length ? 'hidden':'visible';
}

/* 按钮翻页 */
document.getElementById('book-prev').addEventListener('click', ()=>{
  document.getElementById('book-intro').classList.add('hidden');
  if(bookPage>0){ bookPage--; updateBook(); }
  if(bookPage<=0){ document.getElementById('book-intro').classList.remove('hidden'); }
});
document.getElementById('book-next').addEventListener('click', ()=>{
  document.getElementById('book-next').classList.remove('breathe');
  document.getElementById('book-intro').classList.add('hidden');
  if(bookPage<BOOK_PAGES.length){ bookPage++; updateBook(); }
});

/* 拖拽翻页（参考 page-flip-tw） */
let dragging = null; /* {page, startX, startAngle} */
const bookStage = document.querySelector('.book-stage');

bookStage.addEventListener('mousedown', (e)=>{
  /* 只在未翻的右页上按下才开始拖拽 */
  const pages = bpagesEl.querySelectorAll('.bpage');
  const target = pages[bookPage]; /* 当前最上面的未翻页 */
  if(!target) return;
  const rect = target.getBoundingClientRect();
  /* 按下位置在右半本范围内 */
  if(e.clientX < rect.left) return;
  dragging = {
    page: target,
    startX: e.clientX,
    idx: bookPage
  };
  target.classList.add('dragging');
  e.preventDefault();
});
document.addEventListener('mousemove', (e)=>{
  if(!dragging) return;
  const dx = e.clientX - dragging.startX;
  /* 向右拖 = 翻回去的方向，向左拖 = 翻过去 */
  /* 当前页宽550，拖过550px = -180度 */
  const angle = Math.max(-180, Math.min(0, dx / 550 * 180));
  dragging.page.style.transform = `rotateY(${angle}deg)`;
});
document.addEventListener('mouseup', (e)=>{
  if(!dragging) return;
  const dx = e.clientX - dragging.startX;
  dragging.page.classList.remove('dragging');
  dragging.page.style.transform = '';
  if(dx < -150){
    bookPage = Math.min(BOOK_PAGES.length, dragging.idx + 1);
  }
  updateBook();
  dragging = null;
});

buildBook();

let bookIntroDone = false;
function startBookIntro(){
  if(bookIntroDone) return;
  bookIntroDone = true;
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&*';
  function reveal(el, text, done){
    let frame = 0;
    const total = text.length * 3;
    const iv = setInterval(()=>{
      let out = '';
      for(let i=0;i<text.length;i++){
        if(text[i]===' '){out+=' ';continue;}
        if(i<frame/3){out+=text[i];}
        else{out+=CHARS[Math.floor(Math.random()*CHARS.length)];}
      }
      el.textContent = out;
      frame++;
      if(frame>=total){el.textContent=text;clearInterval(iv);if(done)done();}
    },30);
  }
  reveal(document.getElementById('book-line1'),'Examples of my writing.',()=>{
    document.getElementById('book-line2').style.opacity=1;
    reveal(document.getElementById('book-line2'),'Click the book to read my work.',()=>{});
  });
}

let introDone = false;
function autoFlipIntro(){
  if(introDone) return;
  introDone = true;
  const nextBtn = document.getElementById('book-next');
  nextBtn.classList.remove('breathe');
  const pages = document.querySelectorAll('.bpage');
  pages.forEach(p=>p.style.transitionDuration='0.12s');
  const total = BOOK_PAGES.length;
  let i = 0;
  const timer = setInterval(()=>{
    i++;
    if(i >= total){
      clearInterval(timer);
      let j = total;
      const backTimer = setInterval(()=>{
        j--;
        bookPage = j;
        updateBook();
        if(j <= 0){
          clearInterval(backTimer);
          pages.forEach(p=>p.style.transitionDuration='');
          nextBtn.classList.add('breathe');
          document.getElementById('book-intro').classList.remove('hidden');
        }
      }, 130);
      return;
    }
    bookPage = i;
    updateBook();
  }, 140);
}

function autoFlipBack(){
  const nextBtn = document.getElementById('book-next');
  nextBtn.classList.remove('breathe');
  const pages = document.querySelectorAll('.bpage');
  pages.forEach(p=>p.style.transitionDuration='0.12s');
  let j = BOOK_PAGES.length;
  const backTimer = setInterval(()=>{
    j--;
    bookPage = j;
    updateBook();
    if(j <= 0){
      clearInterval(backTimer);
      pages.forEach(p=>p.style.transitionDuration='');
      nextBtn.classList.add('breathe');
      document.getElementById('book-intro').classList.remove('hidden');
    }
  }, 130);
}

/* 点击书触发自动翻页 */
document.querySelector('.book-stage').addEventListener('click', (e)=>{
  if(e.target.closest('.book-nav')) return;
  document.getElementById('book-intro').classList.add('hidden');
  if(!introDone){
    autoFlipIntro();
  }else if(bookPage >= BOOK_PAGES.length){
    autoFlipBack();
  }
});

