function centerOf(el){
  const r = el.getBoundingClientRect();
  const stage = document.getElementById('stage');
  const sr = stage.getBoundingClientRect();
  const s = sr.width/1920;
  return { x:(r.left+r.width/2-sr.left)/s, y:(r.top+r.height/2-sr.top)/s };
}
function drawCords(){
  const svg = document.getElementById('cords');
  svg.innerHTML = '';
  const center = centerOf(document.getElementById('center-focal'));
  const cardIds = ['card-polaroid','card-badge','card-sketch','card-note','card-map'];
  const pts = cardIds.map(id=>centerOf(document.getElementById(id)));
  pts.forEach(p=>{
    const mx = (center.x + p.x)/2, my = (center.y + p.y)/2;
    const dx = p.x - center.x, dy = p.y - center.y;
    const dist = Math.sqrt(dx*dx+dy*dy);
    const bend = Math.min(40, dist*0.12);
    const nx = -dy/dist, ny = dx/dist;
    const cx = mx + nx*bend, cy = my + ny*bend;
    const path = document.createElementNS('http://www.w3.org/2000/svg','path');
    path.setAttribute('d', `M ${center.x} ${center.y} Q ${cx} ${cy} ${p.x} ${p.y}`);
    svg.appendChild(path);
    const knot = document.createElementNS('http://www.w3.org/2000/svg','circle');
    knot.setAttribute('cx', p.x); knot.setAttribute('cy', p.y);
    knot.setAttribute('r', 4); knot.setAttribute('class','knot');
    svg.appendChild(knot);
  });
  const cknot = document.createElementNS('http://www.w3.org/2000/svg','circle');
  cknot.setAttribute('cx', center.x); cknot.setAttribute('cy', center.y);
  cknot.setAttribute('r', 6); cknot.setAttribute('class','knot');
  svg.appendChild(cknot);
}
