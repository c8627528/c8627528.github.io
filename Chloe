  const n = DESIGN_CARDS.length;
  const mid = (n-1)/2;
  if(open){
    return `translateX(${(i-mid)*SPACING}px) rotate(${(i-mid)*3}deg)`;
  }
  return `translateY(${(n-1-i)*2}px) rotate(${(i-mid)*1.5}deg)`;
}
function setAll(open){
  stackWrap.querySelectorAll('.stack-card').forEach((o, oi)=>{
    o.style.transform = baseT(oi, open);
    o.style.zIndex = oi;
  });
