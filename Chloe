  {url:'https://aka.doubaocdn.com/s/Q7bKigzM3p', label:'REEL 04'},
  {url:'https://aka.doubaocdn.com/s/ox6QkerFR0', label:'REEL 05'},
];
let reelInited = false;
function initReel(){
  if(reelInited) return;
  reelInited = true;
  const strip = document.getElementById('reel-strip');
  const stage = document.getElementById('reel-stage');
  const n = REEL_VIDEOS.length;
  // 复制3组做环形
  const all = [...REEL_VIDEOS, ...REEL_VIDEOS, ...REEL_VIDEOS];
  all.forEach((v, i)=>{
    const frame = document.createElement('div');
    frame.className = 'reel-frame';
    frame.innerHTML = `<video src="${v.url}" loop muted playsinline preload="metadata"></video><div class="reel-label">${v.label}</div>`;
    strip.appendChild(frame);
  });
  // 初始滚动到中间组的第一个
  setTimeout(()=>{
    const firstH = strip.children[0].offsetHeight;
    stage.scrollTop = n * (firstH + 30);
  }, 200);
  function updatePlaying(){
    const stageR = stage.getBoundingClientRect();
    const centerY = stageR.top + stageR.height/2;
    strip.querySelectorAll('.reel-frame').forEach(f=>{
      const r = f.getBoundingClientRect();
      const fMid = r.top + r.height/2;
      const v = f.querySelector('video');
      if(Math.abs(fMid - centerY) < r.height*0.4){
        v.play().catch(()=>{});
        f.classList.add('playing');
      }else{
        v.pause();
        f.classList.remove('playing');
      }
    });
  }
  stage.addEventListener('scroll', ()=>{
    requestAnimationFrame(updatePlaying);
    const frameH = strip.children[0].offsetHeight + 30;
    const groupH = n * frameH;
    if(stage.scrollTop < groupH){
      stage.scrollTop += groupH;
    }else if(stage.scrollTop > groupH*2){
      stage.scrollTop -= groupH;
    }
  });
  // 声音按钮
  let soundOn = false;
  const soundBtn = document.getElementById('reel-sound');
  soundBtn.addEventListener('click', ()=>{
    soundOn = !soundOn;
    strip.querySelectorAll('.reel-frame video').forEach(v=>{
      v.muted = !soundOn;
      if(soundOn) v.volume = 1;
    });
    soundBtn.textContent = soundOn ? 'SOUND: ON' : 'SOUND: OFF';
  });
  setTimeout(updatePlaying, 800);
}



