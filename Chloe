/* Cipher reveal */
const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&*';
function cipherReveal(el, text, done, speed){
  speed = speed || 30;
  let frame = 0;
  const total = text.length * 3;
  const iv = setInterval(()=>{
    let out = '';
    for(let i=0;i<text.length;i++){
      if(text[i] === ' '){ out += ' '; continue; }
      if(i < frame/3){ out += text[i]; }
      else{ out += CHARS[Math.floor(Math.random()*CHARS.length)]; }
    }
    el.textContent = out;
    frame++;
    if(frame >= total){
      el.textContent = text;
      clearInterval(iv);
      if(done) done();
    }
  }, speed);
}
